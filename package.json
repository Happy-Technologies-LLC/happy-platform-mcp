{
  "name": "happy-platform-mcp",
  "version": "5.2.2",
  "description": "Happy MCP Server — Model Context Protocol server for the ServiceNow platform with 480+ auto-generated tools, multi-instance support, and natural language search",
  "main": "src/server.js",
  "type": "module",
  "mcpName": "io.github.nickzitzer/happy-platform-mcp",
  "bin": {
    "happy-platform-mcp": "src/cli.js",
    "servicenow-mcp-server": "src/cli.js"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "stdio": "node src/stdio-server.js",
    "inspector": "npx @modelcontextprotocol/inspector",
    "extract-metadata": "node scripts/extract-table-metadata.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:verbose": "NODE_OPTIONS=--experimental-vm-modules jest --verbose",
    "release": "./scripts/release.sh",
    "test:package": "node scripts/verify-package.mjs",
    "stats": "node scripts/usage-stats.mjs"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@napi-rs/keyring": "^2.1.0",
    "axios": "1.20.0",
    "chokidar": "^4.0.3",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "zod": "^3.25.76"
  },
  "bundleDependencies": [
    "@modelcontextprotocol/sdk"
  ],
  "files": [
    "src/**/*.js",
    "src/config/comprehensive-table-definitions.json",
    "src/config/table-definitions.json",
    "src/config/prompts.md",
    "config/servicenow-instances.json.example",
    "assets/logo.svg",
    "assets/logo-400x400.png",
    "docs/*.md",
    "scripts/verify-package.mjs",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE",
    "NOTICE",
    "server.json"
  ],
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^30.4.2"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "4.3.2"
    },
    "glob": "13.0.6",
    "minimatch": "10.2.6",
    "test-exclude": "8.0.0"
  },
  "author": "Happy Technologies LLC",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Happy-Technologies-LLC/happy-platform-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/Happy-Technologies-LLC/happy-platform-mcp/issues"
  },
  "homepage": "https://github.com/Happy-Technologies-LLC/happy-platform-mcp#readme",
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/Happy-Technologies-LLC"
    },
    {
      "type": "buy_me_a_coffee",
      "url": "https://buymeacoffee.com/nickzitzer"
    }
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "happy-platform",
    "itsm",
    "claude",
    "ai",
    "automation",
    "rest-api",
    "service-catalog",
    "cmdb",
    "workflow",
    "multi-instance"
  ],
  "optionalDependencies": {
    "better-sqlite3": "^12.9.0",
    "sqlite-vec": "^0.1.9"
  }
}
