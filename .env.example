# Legacy singular ServiceNow fallback (backward-compatible)
# Prefer: `happy-platform-mcp instance add` and local keychain credentials.
# These variables are read only when no registry file is available. Do not commit
# real values or use this fallback when a shared environment can expose .env.
# SERVICENOW_INSTANCE_URL=https://your-instance.service-now.com
# SERVICENOW_USERNAME=your-username
# SERVICENOW_PASSWORD=
# SERVICENOW_AUTH_TYPE=basic
# SERVICENOW_CLIENT_ID=your-client-id
# SERVICENOW_CLIENT_SECRET=
# SERVICENOW_OAUTH_GRANT_TYPE=client_credentials

# Optional explicit metadata registry path. Supports ~ and relative paths from cwd.
# HAPPY_CONFIG_PATH=~/.config/happy-platform-mcp/instances.json

# Server Configuration
PORT=3000
DEBUG=true

# HTTP/SSE transport (`npm start`, Docker). stdio does not read these.
# Required for every HTTP listener, including loopback: 32 random bytes as
# 64 hex characters (or 43 base64url). Generate with `openssl rand -hex 32`.
# Clients send it as `Authorization: Bearer <token>`. Never commit a real value.
HAPPY_MCP_API_TOKEN=
# HAPPY_MCP_BIND_HOST=127.0.0.1
# Extra Host header authorities to accept, comma-separated host[:port] (e.g. a reverse proxy name).
# HAPPY_MCP_ALLOWED_HOSTS=mcp.example.com
# Exact browser origins allowed to send requests, comma-separated. Unset rejects any Origin header.
# HAPPY_MCP_ALLOWED_ORIGINS=https://console.example.com

# Optional ServiceNowDocs local search
# Live GitHub docs discovery/get work without local indexing.
HAPPY_DOCS_ENABLE_LOCAL_INDEX=false
HAPPY_DOCS_CACHE_DIR=
HAPPY_DOCS_ENABLE_VECTOR=false
HAPPY_DOCS_EMBEDDING_PROVIDER=none
