{
  "after": {
    "keyringAccounts": [],
    "keyringValueMatchesFakeSecret": {},
    "registryJson": {
      "instances": [
        {
          "authType": "basic",
          "credentialRef": "keychain:instance/dev/password",
          "default": true,
          "description": "Golden dev",
          "name": "dev",
          "url": "{{INSTANCE_URL}}",
          "username": "golden.user"
        },
        {
          "authType": "oauth",
          "clientId": "golden-client",
          "credentialRef": "keychain:instance/oauth1/client-secret",
          "description": "Golden oauth",
          "grantType": "client_credentials",
          "name": "oauth1",
          "url": "{{INSTANCE_URL}}"
        }
      ],
      "version": 1
    }
  },
  "argv": [
    "instance",
    "credential",
    "set",
    "dev",
    "--type",
    "password"
  ],
  "bin": "happy-platform-mcp",
  "exit": {
    "code": 2,
    "signal": null
  },
  "id": "cli/credential-set-non-tty",
  "mode": "subprocess-bin-symlink, stdin=/dev/null (non-TTY)",
  "outbound": [],
  "stderr": "Non-interactive use requires an interactive TTY for masked prompts; rerun in a terminal or inject the required prompt function.\n",
  "stdout": ""
}
