{
  "after": {
    "keyringAccounts": [
      "keychain:instance/dev/password",
      "keychain:instance/oauth1/client-secret"
    ],
    "keyringValueMatchesFakeSecret": {
      "keychain:instance/dev/password": true,
      "keychain:instance/oauth1/client-secret": true
    },
    "registryJson": {
      "instances": [
        {
          "authType": "basic",
          "credentialRef": "keychain:instance/dev/password",
          "default": true,
          "description": "Golden dev",
          "name": "dev",
          "url": "{{INSTANCE_URL}}",
          "username": "golden.user"
        },
        {
          "authType": "oauth",
          "clientId": "golden-client",
          "credentialRef": "keychain:instance/oauth1/client-secret",
          "description": "Golden oauth",
          "grantType": "client_credentials",
          "name": "oauth1",
          "url": "{{INSTANCE_URL}}"
        }
      ],
      "version": 1
    }
  },
  "argv": [
    "instance",
    "update",
    "dev",
    "--frobnicate",
    "x"
  ],
  "bin": "happy-platform-mcp",
  "exit": {
    "code": 2,
    "signal": null
  },
  "id": "cli/update-unknown-option",
  "mode": "subprocess-bin-symlink, stdin=/dev/null (non-TTY)",
  "outbound": [],
  "stderr": "Unknown option.\nUsage:\n  happy-platform-mcp instance add\n  happy-platform-mcp instance list\n  happy-platform-mcp instance update <name> [metadata flags; auth changes require remove/re-add]\n  happy-platform-mcp instance test <name>\n  happy-platform-mcp instance remove <name>\n  happy-platform-mcp instance credential set <name> --type password|client-secret\n  happy-platform-mcp instance migrate\n",
  "stdout": ""
}
