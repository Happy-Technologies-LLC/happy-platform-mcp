{
  "after": {
    "keyringAccounts": [
      "keychain:instance/dev/password",
      "keychain:instance/oauth1/client-secret"
    ],
    "keyringValueMatchesFakeSecret": {
      "keychain:instance/dev/password": true,
      "keychain:instance/oauth1/client-secret": true
    },
    "registryJson": {
      "instances": [
        {
          "authType": "basic",
          "credentialRef": "keychain:instance/dev/password",
          "default": true,
          "description": "Golden dev",
          "name": "dev",
          "url": "{{INSTANCE_URL}}",
          "username": "golden.user"
        },
        {
          "authType": "oauth",
          "clientId": "golden-client",
          "credentialRef": "keychain:instance/oauth1/client-secret",
          "description": "Golden oauth",
          "grantType": "client_credentials",
          "name": "oauth1",
          "url": "{{INSTANCE_URL}}"
        }
      ],
      "version": 1
    }
  },
  "argv": [
    "instance",
    "test",
    "dev"
  ],
  "bin": "happy-platform-mcp",
  "exit": {
    "code": 1,
    "signal": null
  },
  "id": "cli/test-http-401",
  "mode": "subprocess-bin-symlink, stdin=/dev/null (non-TTY)",
  "outbound": [
    {
      "body": null,
      "credentials": {
        "scheme": "basic",
        "sessionCookie": false,
        "userToken": false
      },
      "headers": {
        "accept": "application/json",
        "content-type": "application/json",
        "user-agent": "axios/1.20.0"
      },
      "method": "GET",
      "path": "/api/now/table/sys_user",
      "query": [
        [
          "sysparm_limit",
          "1"
        ]
      ],
      "rawQuery": "sysparm_limit=1",
      "target": "servicenow"
    }
  ],
  "stderr": "Authentication failed for 'dev'. Check the credential with instance credential set.\n",
  "stdout": ""
}
