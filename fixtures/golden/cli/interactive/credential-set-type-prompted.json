{
  "after": {
    "keyringAccounts": [
      "keychain:instance/dev/password"
    ],
    "keyringValueMatchesFakeSecret": {
      "keychain:instance/dev/password": true
    },
    "registryJson": {
      "instances": [
        {
          "authType": "basic",
          "credentialRef": "keychain:instance/dev/password",
          "default": true,
          "description": "Golden dev",
          "name": "dev",
          "url": "{{INSTANCE_URL}}",
          "username": "golden.user"
        },
        {
          "authType": "oauth",
          "clientId": "golden-client",
          "credentialRef": "keychain:instance/oauth1/client-secret",
          "default": false,
          "description": "Golden oauth",
          "grantType": "client_credentials",
          "name": "oauth1",
          "url": "{{INSTANCE_URL}}"
        }
      ],
      "version": 1
    }
  },
  "answers": {
    "type": "password"
  },
  "argv": [
    "instance",
    "credential",
    "set",
    "dev"
  ],
  "exit": {
    "code": 0
  },
  "id": "cli/interactive/credential-set-type-prompted",
  "mode": "in-process dispatch(argv, {prompts injected}); real registry file + real credential store over fake keyring",
  "outbound": [],
  "promptCalls": [
    {
      "answered": "password",
      "hasDefault": false,
      "hasMask": false,
      "kind": "select",
      "message": "Credential type:",
      "name": "type"
    },
    {
      "answered": "<masked>",
      "hasDefault": false,
      "hasMask": true,
      "kind": "password",
      "message": "Password:",
      "name": "secret"
    }
  ],
  "runnerError": null,
  "stderr": "",
  "stdout": "Credential 'password' updated for instance 'dev'.\n"
